DBGATE_CONTAINER_NAME=dbgate
DBGATE_BIND_IP=127.0.0.1
DBGATE_PORT=3000
DBGATE_VOLUME_NAME=dbgate_data
DBGATE_LOGIN=admin
DBGATE_PASSWORD=change-this-dbgate-password
DBGATE_BASIC_AUTH=1
# Leave empty to add connections in the UI.
# Optional IDs (kept for existing env files): crypto_postgres,crypto_mongo
DBGATE_CONNECTIONS=
DBGATE_POSTGRES_LABEL=PostgreSQL
DBGATE_POSTGRES_URL=
DBGATE_MONGO_LABEL=MongoDB
DBGATE_MONGO_URL=
DATABASE_NETWORK_NAME=database_network
DBGATE_NETWORK_ALIAS=dbgate
TZ=UTC
